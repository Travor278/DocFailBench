    {
      "case_id": "slides_ai_course_001_p1",
      "title": "Lecture title slide with course metadata and repeated footer",
      "document": {
        "path": "data/source_pdfs/placeholder/slides_ai_course_001.pdf",
        "page": 1,
        "license": "placeholder"
      },
      "profile": {
        "language": "zh_en_mixed",
        "document_type": "lecture_slides",
        "layout": ["title_slide", "repeated_footer"],
        "risk_tags": ["header_pollution", "reading_order", "cjk_en_mix"]
