          "params": {
            "text": "人工智能导论"
          }
        },
        {
          "id": "subtitle_present",
          "type": "text_presence",
          "severity": "major",
          "description": "Subtitle with mixed Chinese must be preserved.",
          "tags": ["text"],
          "params": {
            "text": "深度学习基础与应用"
          }
        },
        {
          "id": "school_name",
          "type": "text_presence",
          "severity": "major",
          "description": "School/department name must appear.",
          "tags": ["text"],
          "params": {
            "text": "北京大学计算机科学与技术学院"
          }
        },
        {
          "id": "instructor_name",
          "type": "text_presence",
          "severity": "major",
          "description": "Instructor name must be extracted.",
          "tags": ["text"],
          "params": {
            "text": "张明教授"
          }
        },
        {
          "id": "semester_info",
          "type": "text_presence",
          "severity": "major",
          "description": "Semester information must be present.",
          "tags": ["text"],
          "params": {
            "text": "2026年春季学期"
          }
        },
        {
          "id": "school_before_instructor",
          "type": "reading_order",
          "severity": "major",
          "description": "School name must appear before instructor name.",
          "tags": ["reading_order"],
          "params": {
            "before": "北京大学计算机科学与技术学院",
            "after": "张明教授"
          }
        },
        {
          "id": "no_slide_footer_p1",
          "type": "regex_absence",
          "severity": "minor",
          "description": "Slide footer page number text should not pollute body content.",
          "tags": ["pollution"],
          "params": {
            "pattern": "第1页"
          }
        },
        {
          "id": "no_tail_repetition",
          "type": "no_repeated_ngram_tail",
          "severity": "major",
          "description": "Output must not end with repeated n-gram artifacts.",
          "tags": ["quality"],
          "params": {
            "n": 4,
            "max_repeats": 4
          }
        }
      ],
      "notes": "Tests title slide metadata extraction with repeated footer pollution detection."
    },
