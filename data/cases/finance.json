{
  "version": "0.1",
  "cases": [
    {
      "case_id": "finance_annual2024_p4",
      "title": "Financial highlights table with merged header and dense numeric data",
      "document": {
        "path": "data/source_pdfs/placeholder/finance_annual_report_2024.pdf",
        "page": 4,
        "license": "placeholder"
      },
      "profile": {
        "language": "zh",
        "document_type": "financial_report",
        "layout": ["merged_header", "dense_numbers"],
        "risk_tags": ["table", "numeric_fidelity"]
      },
      "assertions": [
        {
          "id": "highlights_title",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Financial highlights section title must survive extraction.",
          "tags": ["text"],
          "params": {
            "text": "主要财务数据和财务指标"
          }
        },
        {
          "id": "revenue_cell",
          "type": "table_cell_exists",
          "severity": "blocker",
          "description": "Revenue row label must appear as a table cell.",
          "tags": ["table"],
          "params": {
            "text": "营业收入"
          }
        },
        {
          "id": "net_profit_cell",
          "type": "table_cell_exists",
          "severity": "blocker",
          "description": "Net profit row label must appear.",
          "tags": ["table"],
          "params": {
            "text": "净利润"
          }
        },
        {
          "id": "revenue_amount_regex",
          "type": "regex_match",
          "severity": "blocker",
          "description": "Revenue amount with comma-separated digits must be preserved.",
          "tags": ["numeric"],
          "params": {
            "pattern": "1,285,432\\.67"
          }
        },
        {
          "id": "roe_cell",
          "type": "table_cell_exists",
          "severity": "major",
          "description": "ROE metric label must appear in table.",
          "tags": ["table"],
          "params": {
            "text": "净资产收益率"
          }
        },
        {
          "id": "highlights_shape",
          "type": "table_shape",
          "severity": "major",
          "description": "Highlights table should have at least 6 rows and 4 columns.",
          "tags": ["table"],
          "params": {
            "row_count": 9,
            "col_count": 4
          }
        },
        {
          "id": "no_tail_loop",
          "type": "no_repeated_ngram_tail",
          "severity": "major",
          "description": "Output must not end with repeated n-gram artifacts.",
          "tags": ["quality"],
          "params": {
            "n": 4,
            "max_repeats": 4
          }
        }
      ],
      "notes": "Tests merged-header financial highlights table. Parsers must preserve row labels and numeric amounts with comma formatting."
    },
