          "id": "no_tail_loop",
          "type": "no_repeated_ngram_tail",
          "severity": "major",
          "description": "Output must not end with repeated n-gram artifacts.",
          "tags": ["quality"],
          "params": {
            "n": 4,
            "max_repeats": 4
          }
        }
      ],
      "notes": "Tests borderless table extraction for balance sheet assets section."
