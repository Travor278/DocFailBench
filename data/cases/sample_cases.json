{
  "version": "0.1",
  "cases": [
    {
      "case_id": "zh_paper_double_column_001_p3",
      "title": "Chinese/English double-column paper page with table and formula",
      "document": {
        "path": "data/source_pdfs/placeholder/zh_paper_double_column_001.pdf",
        "page": 3,
        "license": "placeholder"
      },
      "profile": {
        "language": "zh_en_mixed",
        "document_type": "academic_paper",
        "layout": ["double_column", "formula_dense", "markdown_table"],
        "risk_tags": ["reading_order", "formula", "table"]
      },
      "assertions": [
        {
          "id": "title_present",
          "type": "text_presence",
          "severity": "major",
          "description": "The page title must survive extraction.",
          "tags": ["text"],
          "params": {
            "text": "基于视觉语言模型的文档理解"
          }
        },
        {
          "id": "running_header_removed",
          "type": "text_absence",
          "severity": "major",
          "description": "Repeated journal headers should not pollute Markdown.",
          "tags": ["pollution"],
          "params": {
            "text": "中国人工智能学会通讯 2026 年第 3 期"
          }
        },
        {
          "id": "caption_after_figure_anchor",
          "type": "reading_order",
          "severity": "blocker",
          "description": "Figure caption should appear after the figure anchor.",
          "tags": ["reading_order", "figure"],
          "params": {
            "before": "图 2",
            "after": "图 2 实验流程"
          }
        },
        {
          "id": "model_cell_qwen_exists",
          "type": "table_cell_exists",
          "severity": "major",
          "description": "Model names inside comparison table should be preserved.",
          "tags": ["table"],
          "params": {
            "text": "Qwen2.5-VL"
          }
        },
        {
          "id": "core_sum_formula",
          "type": "formula_contains",
          "severity": "blocker",
          "description": "The summation formula must be preserved as LaTeX.",
          "tags": ["formula"],
          "params": {
            "latex": "\\sum_{i=1}^{n}"
          }
        },
        {
          "id": "title_grounded",
          "type": "element_grounded",
          "severity": "blocker",
          "description": "Title text must be spatially grounded in a bbox.",
          "tags": ["grounding"],
          "params": {
            "text": "基于视觉语言模型的文档理解"
          }
        }
      ],
      "notes": "Synthetic placeholder case. Replace document path with a redistributable PDF page before release."
    },
