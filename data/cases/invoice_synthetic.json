        {
          "id": "total_chinese",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Total price-plus-tax in Chinese uppercase must appear.",
          "tags": ["text", "amount"],
          "params": { "text": "肆拾柒万肆仟捌佰捌拾元整" }
        },
        {
          "id": "amount_before_tax",
          "type": "reading_order",
          "severity": "major",
          "description": "Subtotal must appear before tax amount.",
          "tags": ["reading_order"],
          "params": { "before": "合计金额", "after": "税额" }
        },
        {
          "id": "subtotal_before_total",
          "type": "reading_order",
          "severity": "major",
          "description": "Subtotal must appear before grand total.",
          "tags": ["reading_order"],
          "params": { "before": "合计金额", "after": "价税合计" }
        },
        {
          "id": "no_page2_footer",
          "type": "regex_absence",
          "severity": "minor",
          "description": "Page footer text should not pollute body content.",
          "tags": ["pollution"],
          "params": { "pattern": "增值税电子普通发票\\s*·\\s*第2页" }
        },
        {
          "id": "no_tail_repetition",
          "type": "no_repeated_ngram_tail",
          "severity": "major",
          "description": "Output must not end with repeated n-gram artifacts.",
          "tags": ["quality"],
          "params": { "n": 4, "max_repeats": 4 }
        }
      ],
      "notes": "Tests invoice financial totals: numeric and Chinese uppercase amounts, tax rate/amount, reading order of subtotal before tax before total, and footer pollution."
    },
