{
  "version": "0.1",
  "cases": [
    {
      "case_id": "invoice_vat_001_p1",
      "title": "VAT invoice header with buyer/seller fields and line-item table",
      "document": {
        "path": "data/source_pdfs/placeholder/invoice_vat_001.pdf",
        "page": 1,
        "license": "placeholder"
      },
      "profile": {
        "language": "zh_en_mixed",
        "document_type": "invoice",
        "layout": ["line_item_table", "repeated_footer"],
        "risk_tags": ["entity_field_loss", "table", "cjk_en_mix", "numeric_fidelity", "header_pollution"]
      },
      "assertions": [
        {
          "id": "invoice_title",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Invoice title '增值税电子普通发票' must survive extraction.",
          "tags": ["text"],
          "params": { "text": "增值税电子普通发票" }
        },
        {
          "id": "invoice_code",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Invoice code must be extracted intact.",
          "tags": ["text", "numeric"],
          "params": { "text": "发票代码：011002500311" }
        },
        {
          "id": "invoice_number",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Invoice number must be extracted intact.",
          "tags": ["text", "numeric"],
          "params": { "text": "发票号码：08726145" }
        },
        {
          "id": "invoice_date",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Invoice issue date must be preserved.",
          "tags": ["date"],
          "params": { "text": "开票日期：2026年04月18日" }
        },
        {
          "id": "buyer_name",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Buyer company name must appear.",
          "tags": ["text"],
          "params": { "text": "杭州星辰智能科技有限公司" }
        },
        {
          "id": "buyer_taxid",
          "type": "regex_match",
          "severity": "blocker",
          "description": "Buyer taxpayer ID must be preserved.",
          "tags": ["numeric"],
          "params": { "pattern": "91330100MA2K[A-Z]+" }
        },
        {
          "id": "seller_name",
          "type": "text_presence",
          "severity": "blocker",
          "description": "Seller company name must appear.",
          "tags": ["text"],
          "params": { "text": "北京云计算服务有限公司" }
        },
        {
          "id": "seller_taxid",
          "type": "regex_match",
          "severity": "blocker",
          "description": "Seller taxpayer ID must be preserved.",
          "tags": ["numeric"],
          "params": { "pattern": "91110108MA01[A-Z]+" }
        },
        {
          "id": "buyer_label",
          "type": "text_presence",
          "severity": "major",
          "description": "Buyer section label must appear.",
          "tags": ["text"],
          "params": { "text": "购买方" }
        },
        {
          "id": "seller_label",
          "type": "text_presence",
          "severity": "major",
          "description": "Seller section label must appear.",
          "tags": ["text"],
          "params": { "text": "销售方" }
        },
        {
          "id": "item_api_service",
          "type": "table_cell_exists",
          "severity": "blocker",
          "description": "API service fee item must appear in line-item table.",
          "tags": ["table", "cjk_en_mix"],
          "params": { "text": "API服务费" }
        },
        {
          "id": "item_sdk_support",
          "type": "table_cell_exists",
          "severity": "blocker",
          "description": "SDK technical support item must appear in line-item table.",
          "tags": ["table", "cjk_en_mix"],
          "params": { "text": "SDK技术支持" }
        },
        {
          "id": "item_cloud_server",
          "type": "table_cell_exists",
          "severity": "major",
          "description": "Cloud server rental item must appear in line-item table.",
          "tags": ["table"],
          "params": { "text": "云服务器租赁" }
        },
        {
          "id": "item_database",
          "type": "table_cell_exists",
          "severity": "major",
          "description": "Database service item must appear in line-item table.",
          "tags": ["table"],
          "params": { "text": "数据库服务" }
        },
        {
          "id": "table_header_name",
          "type": "table_cell_exists",
          "severity": "major",
          "description": "Table header '项目名称' must appear.",
          "tags": ["table"],
          "params": { "text": "项目名称" }
        },
        {
          "id": "invoice_table_shape",
          "type": "table_shape",
          "severity": "major",
          "description": "Invoice line-item table should have 7 rows and 6 columns.",
          "tags": ["table"],
          "params": { "row_count": 7, "col_count": 6 }
        },
        {
          "id": "buyer_before_seller",
          "type": "reading_order",
          "severity": "major",
          "description": "Buyer section must appear before seller section.",
          "tags": ["reading_order"],
          "params": { "before": "购买方", "after": "销售方" }
        },
        {
          "id": "header_before_table",
          "type": "reading_order",
          "severity": "major",
          "description": "Invoice header must appear before line-item table.",
          "tags": ["reading_order"],
          "params": { "before": "增值税电子普通发票", "after": "项目名称" }
        },
        {
          "id": "no_page1_footer",
          "type": "regex_absence",
          "severity": "minor",
          "description": "Page footer text should not pollute body content.",
          "tags": ["pollution"],
          "params": { "pattern": "增值税电子普通发票\\s*·\\s*第1页" }
        },
        {
          "id": "no_standalone_page1",
          "type": "no_page_number",
          "severity": "minor",
          "description": "Standalone page number 1 must not pollute body text.",
          "tags": ["pollution", "page_number"],
          "params": { "page": 1 }
        },
        {
          "id": "no_tail_repetition",
          "type": "no_repeated_ngram_tail",
          "severity": "major",
          "description": "Output must not end with repeated n-gram artifacts.",
          "tags": ["quality"],
          "params": { "n": 4, "max_repeats": 4 }
        }
      ],
      "notes": "Tests invoice header metadata, buyer/seller entity fields, Chinese-English mixed line-item names (API/SDK), table shape, reading order, and footer pollution."
    },
    {
      "case_id": "invoice_vat_001_p2",
      "title": "Invoice totals, tax rate, and tax amount with numeric and Chinese uppercase",
      "document": {
        "path": "data/source_pdfs/placeholder/invoice_vat_001.pdf",
        "page": 2,
        "license": "placeholder"
      },
      "profile": {
        "language": "zh",
